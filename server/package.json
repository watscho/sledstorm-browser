{
  "name": "sledstorm-server",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "package:macos": "node scripts/package-macos.mjs",
    "package:macos:zip": "node scripts/macos-release.mjs",
    "smoke": "node --test \"smoke/*.test.mjs\"",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
